# ---------------------------------------------------------------------------
# autocoder configuration
# Copy to `.env` and edit. Never commit real secrets.
# ---------------------------------------------------------------------------

# LLM provider: one of `mock`, `anthropic`, `openai`, `ollama`.
# `mock` is a deterministic, offline provider used for tests and demos.
AUTOCODER_PROVIDER=mock

# Model used for heavy reasoning (architecture, complex debugging, review).
AUTOCODER_STRONG_MODEL=claude-sonnet-5

# Cheaper/faster model used for classification and summarization.
AUTOCODER_FAST_MODEL=claude-haiku-4-5-20251001

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# AUTOCODER_ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI-compatible ---
# OPENAI_API_KEY=sk-...
# AUTOCODER_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (local) ---
# AUTOCODER_OLLAMA_BASE_URL=http://localhost:11434

# Workspace the agent is allowed to modify (defaults to the current directory).
# AUTOCODER_WORKSPACE=./workspace

# Safety: require confirmation for REQUIRES_CONFIRMATION commands (1) or auto-run (0).
AUTOCODER_REQUIRE_CONFIRMATION=1

# Command execution timeout in seconds.
AUTOCODER_COMMAND_TIMEOUT=120

# Retry/iteration bounds.
AUTOCODER_MAX_ATTEMPTS_PER_TASK=5
AUTOCODER_MAX_DEBUG_ITERATIONS=5
